################################################################################
# FLASK - Configurações Principais da Aplicação
################################################################################
FLASK_ENV=production
FLASK_DEBUG=False

# Chave secreta para sessões e CSRF - MUDE ESTE VALOR EM PRODUÇÃO!
# Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-in-production

# Porta da aplicação (padrão: 5000)
PORT=5000

################################################################################
# SEGURANÇA - Credenciais Encriptadas
################################################################################

# Senha mestre para descriptografia dos segredos armazenados em secrets.enc
# MANTENHA ESTE VALOR SEGURO! Use um gerenciador de secrets em produção
MASTER_PASSWORD=

################################################################################
# ACTIVE DIRECTORY / LDAP
################################################################################

# Servidor AD - endereço DNS ou IP do seu controlador de domínio
AD_SERVER=your-ad-server.local

# Usar SSL/TLS para conexão LDAP (recomendado em produção)
AD_USE_SSL=True

# Configurações de domínio
AD_BASE_DN=OU=Users,DC=domain,DC=local
AD_SEARCH_BASE=DC=domain,DC=local

# Distinguished Name (DN) do grupo autorizado a usar a ferramenta
# Substitua pelo DN completo do seu grupo de autorização
AD_ALLOWED_GROUP_DN=CN=Authorized_Group,OU=Groups,DC=domain,DC=local

################################################################################
# LOGGING
################################################################################

# Nível de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

################################################################################
# DOCKER ESPECÍFICO
################################################################################

# Estas variáveis são automaticamente definidas pelo docker-compose
# mas podem ser sobrescritas conforme necessário
GUNICORN_WORKERS=4
GUNICORN_THREADS=1
GUNICORN_WORKER_CLASS=sync