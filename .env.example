# Configurações Flask
SECRET_KEY=your-super-secret-key-change-in-production
FLASK_ENV=development

# Senha mestre para descriptografia dos segredos (GUARDE EM LOCAL SEGURO!)
MASTER_PASSWORD=

# Configurações AD (sem credenciais hardcoded)
AD_SERVER=your-ad-server.local
AD_USE_SSL=True
AD_BASE_DN=OU=Users,DC=domain,DC=local
AD_SEARCH_BASE=DC=domain,DC=local

# Grupo do AD autorizado a usar a ferramenta
# Substitua pelo Distinguished Name completo do grupo de autorização
AD_ALLOWED_GROUP_DN=CN=Authorized_Group,OU=Groups,DC=domain,DC=local

# Configurações AD legadas (remover após migração completa)
# Credenciais agora armazenadas de forma encriptada em secrets.enc